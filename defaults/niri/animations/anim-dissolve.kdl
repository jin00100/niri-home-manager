// ── Pixel Dissolve [Pixel Dissolve] ──────────────────────────────────────────────────
animations {
    window-open {
        duration-ms 220
        curve "linear"
        custom-shader r"
            float hash21(vec2 p) {
                p = fract(p * vec2(234.34, 435.345));
                p += dot(p, p + 34.23);
                return fract(p.x * p.y);
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0) {
                    return vec4(0.0);
                }
                float p = niri_clamped_progress;
                vec2 grid_pos = floor(coords_geo.xy * size_geo.xy / 5.0);
                float rnd = hash21(grid_pos);

                if (rnd > p * 1.2) {
                    return vec4(0.0);
                }

                vec3 coords_tex = niri_geo_to_tex * coords_geo;
                return texture2D(niri_tex, coords_tex.st) * p;
            }
        "
    }

    window-close {
        duration-ms 240
        curve "linear"
        custom-shader r"
            float hash21(vec2 p) {
                p = fract(p * vec2(234.34, 435.345));
                p += dot(p, p + 34.23);
                return fract(p.x * p.y);
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                if (coords_geo.x < 0.0 || coords_geo.x > 1.0 || coords_geo.y < 0.0 || coords_geo.y > 1.0) {
                    return vec4(0.0);
                }
                float p = niri_clamped_progress;
                vec2 grid_pos = floor(coords_geo.xy * size_geo.xy / 5.0);
                float rnd = hash21(grid_pos);

                if (rnd < p * 1.15) {
                    return vec4(0.0);
                }

                vec2 offset = vec2((rnd - 0.5) * 30.0, -rnd * 25.0) * p / size_geo.xy;
                vec3 coords_tex = niri_geo_to_tex * vec3(coords_geo.xy + offset, 1.0);
                return texture2D(niri_tex, coords_tex.st) * (1.0 - p);
            }
        "
    }
}
