{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": {
            "1": "cyan"
        }
    },
    "display": {
        "color": {
            "keys": "cyan",
            "title": "cyan"
        },
        "disableLinewrap": true,
        "size": {
            "maxPrefix": "MB",
            "ndigits": 0,
            "spaceBeforeUnit": "never"
        },
        "freq": {
            "ndigits": 3,
            "spaceBeforeUnit": "never"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        {
            "type": "host",
            "format": "lua:local args = ...; return (args.name:gsub(\"%s*%b()\", \"\"))"
        },
        {
            "type": "kernel",
            "format": "{release}"
        },
        "uptime",
        {
            "type": "packages",
            "format": "{?pacman}{pacman} (pacman){?}{/pacman}{all} (pkgs){/}"
        },
        "shell",
        {
            "type": "display",
            "compactType": "original",
            "key": "Resolution"
        },
        "de",
        {
            "type": "wm",
            "format": "{pretty-name}{?version} {version}{?}"
        },
        "wmtheme",
        "theme",
        "icons",
        "terminal",
        "cpu",
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "format": "{used} / {total}"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
